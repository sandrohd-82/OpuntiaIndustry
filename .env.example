# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo server (Edge Functions / service role — mai esporre al client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pubblica dell'app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP Aruba (invio OTP email) — solo server
EMAIL_FROM=support@opuntiaindustry.com
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=support@opuntiaindustry.com
SMTP_PASS=your-smtp-password

# Cifratura secret Google Authenticator (opzionale; fallback = SERVICE_ROLE_KEY)
# TOTP_ENCRYPTION_KEY=una-stringa-lunga-casuale

# Bootstrap unico superadmin: npm run create-superadmin
# SUPERADMIN_EMAIL=tuo@email.it
# SUPERADMIN_PASSWORD=password-sicura
# SUPERADMIN_FULL_NAME=Il Tuo Nome
