# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo server (Edge Functions / service role — mai esporre al client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pubblica dell'app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps (chat: condivisione posizione) — chiave browser (HTTP referrer)
# Guida: crea progetto Cloud → attiva Maps JavaScript API + Places API → API key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# SMTP Aruba (invio OTP email) — solo server
EMAIL_FROM=support@opuntiaindustry.com
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=support@opuntiaindustry.com
SMTP_PASS=your-smtp-password

# Cifratura secret Google Authenticator (opzionale; fallback = SERVICE_ROLE_KEY)
# TOTP_ENCRYPTION_KEY=una-stringa-lunga-casuale

# Bootstrap unico superadmin: npm run create-superadmin
# SUPERADMIN_EMAIL=tuo@email.it
# SUPERADMIN_PASSWORD=password-sicura
# SUPERADMIN_FULL_NAME=Il Tuo Nome

# Fatture in Cloud API v2 (solo server — mai nel browser)
# Token = “chiave segreta” dell’app creata su developers.fattureincloud.it
# Company ID = numero azienda (lo vedi nell’URL di Fatture in Cloud o nelle impostazioni API)
# Per emissione/sync servono scope: issued_documents.invoices:r/a, issued_documents.credit_notes:r,
# entity.clients:r, e-invoice send/email
FIC_API_TOKEN=
FIC_COMPANY_ID=

# Webmail (Gmail / Aruba) — sync IMAP + bozze AI — solo server
# Procedure: docs/WEBMAIL-COLLEGAMENTO-GMAIL-ARUBA.md
WEBMAIL_ENCRYPTION_KEY=
WEBMAIL_AI_ENABLED=true
WEBMAIL_SYNC_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Trascrizione note vocali chat (default whisper-1)
# CHAT_TRANSCRIBE_MODEL=whisper-1
# Learning loop decisioni (osserva/impara) — attivo di default se tabella presente
# LEARNING_ENABLED=true

# Match AI fatture ricevute ↔ catalogo (registrazione) — solo server
GEMINI_API_KEY=
# Opzionale (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# Rapporti banca PDF: modello più preciso (consigliato gpt-4o)
BANK_OPENAI_MODEL=gpt-4o
BANK_IMPORT_MAX_AMOUNT=500000
# Solo emergenza: permette import senza OpenAI (euristica, meno affidabile)
# BANK_PDF_ALLOW_HEURISTIC=1
CRON_SECRET=
